	keywords = {FOS: Computer and information sciences, Computation and Language (cs.CL), Machine Learning (cs.LG)},
	annote = {Other
Accepted at NeurIPS 2020},
	file = {PDF:/Users/alexander/Zotero/storage/Q3Q5LQ2W/Lewis et al. - Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks.pdf:application/pdf},
}

